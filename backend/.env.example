# App
APP_NAME=Customer Ops Backend
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=sqlite:///./customer_ops.db

# LLM / Gemini (get a key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=0.5

# Circuit breaker (agent LLM calls)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30.0

# If true, agents run in a no-LLM-key fallback mode instead of failing startup
DEMO_MODE=false

# RAG
RAG_MIN_SIMILARITY=0.40
RAG_TOP_K=3
CHROMA_PERSIST_DIR=./data/chroma
CHUNK_TARGET_WORDS=150
CHUNK_OVERLAP_WORDS=30

# Escalation auto-approval threshold (percent)
AUTO_APPROVAL_THRESHOLD_PCT=15.0

# Auth - generate a real secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# CORS - only used when DEBUG=false (DEBUG=true allows all origins, no credentials)
CORS_ORIGINS=["http://localhost:3000"]
